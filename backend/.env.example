# Copy to backend/.env and fill in what you need. Everything is optional.

# --- Website (frontend) origins allowed to call this API. Comma-separated; "*" allows any.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Staff admin key (otherwise a random one is printed at every start)
# ADMIN_KEY=change-me

# --- Lilikas Assist AI (any OpenAI-compatible provider). Without a key, simple rules are used instead.
# AI_PROVIDER: nvidia | openai | groq | openrouter | anthropic | ollama
AI_PROVIDER=nvidia
AI_API_KEY=                      # free key from https://build.nvidia.com (starts with nvapi-)
# AI_MODEL=meta/llama-3.3-70b-instruct
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_REASONING_BUDGET=0          # only for NVIDIA "reasoning" models
# ASSIST_AI=off

# --- Alerts
# BAGYO_API_KEY=            # free key from https://bagyo.io/developers (storm alerts)
# PHIVOLCS_API_URL=http://localhost:3000

# --- Routing
# OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot
# DRIVE_KMH=30
